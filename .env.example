# 운영 활성화 전 테스트 모드로 검증하세요. 기본값 false는 결제를 차단합니다.
PAYMENTS_ENABLED=false

# 토스페이먼츠 같은 상점/같은 모드(test_ 또는 live_)의 키를 쌍으로 설정
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=test_gck_your_client_key
TOSS_PAYMENTS_SECRET_KEY=test_gsk_your_secret_key

# Supabase 프로젝트 URL / 서버 전용 서비스 역할 키
# 먼저 supabase/schema.sql 실행 필요 (비밀키를 GitHub에 올리지 마세요)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# 통신판매 신고번호
NEXT_PUBLIC_MAIL_ORDER_NUMBER=제2026-경남거창-00080호

# 구형 ORDER_SIGNING_SECRET은 DB 주문방식에서는 사용하지 않습니다.
